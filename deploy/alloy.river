// Grafana Alloy pipeline: ship mosquitto.log to Loki.
//
// Equivalent to deploy/otelcol-contrib.yaml - see that file's header and
// ../docs/LOGS.md for the full rationale (mosquitto-exporter DESIGN.md
// §5.6, §4, §4.2, §2). Pick ONE of the two deploy/ configs, not both -
// docs/LOGS.md explains which to choose.
//
// This is a FILE tailer. In Docker/Kubernetes, mosquitto's stdout is
// already collected by the container runtime - don't point loki.source.file
// at a file there. See docs/LOGS.md "File vs. container stdout".
//
// Verified against a live eclipse-mosquitto:2.1.2-alpine container
// (2026-08-23): most log lines - every connection-lifecycle and
// protocol-error line included - carry NO "Error:"/"Warning:"/"Notice:"/
// "Information:" word prefix at all; only a minority (config errors,
// missing ACL/cert files, ...) do. The second stage.regex below makes that
// prefix optional so a line without it still matches and keeps its body
// intact - never dropped, never assigned an invented level.

local.file_match "mosquitto" {
	path_targets = [{
		__path__ = "/var/log/mosquitto/mosquitto.log",
		// Correlates these logs with this exporter's metrics in Grafana. Per
		// DESIGN.md §4.1, target identity belongs in scrape/collector config,
		// not invented by an exporter - the same rule applies here. Set this
		// to whatever `instance` label your Prometheus scrape config already
		// assigns to this broker/exporter pair. See docs/LOGS.md "Correlating
		// logs with metrics".
		instance = sys.env("MOSQUITTO_INSTANCE"),
		job      = "mosquitto",
	}]
}

loki.source.file "mosquitto" {
	targets    = local.file_match.mosquitto.targets
	forward_to = [loki.process.mosquitto.receiver]
}

loki.process "mosquitto" {
	forward_to = [loki.write.default.receiver]

	// 1) Split "<epoch-seconds>: <rest of message>" (mosquitto's default
	//    log_dest format). A line that doesn't match this shape at all falls
	//    through with empty capture groups rather than being dropped - Loki
	//    stages never drop a line just because a regex missed.
	stage.regex {
		expression = "^(?P<ts>\\d+): (?P<msg>.*)$"
	}

	stage.timestamp {
		source = "ts"
		format = "Unix"
	}

	// 2) mosquitto prefixes only SOME lines with "Error: " / "Warning: " /
	//    "Notice: " / "Information: ". This group is optional so lines
	//    without it (the majority - see header) still match and keep their
	//    body intact. A bare word like "error" appearing mid-message (e.g.
	//    "Protocol error from ...") is deliberately NOT treated as a
	//    severity signal - only this exact leading prefix is trusted.
	stage.regex {
		source     = "msg"
		expression = "^(?:(?P<level>Error|Warning|Notice|Information): )?(?P<body>.*)$"
	}

	// Promote the (possibly empty) severity word to a Loki label - bounded
	// cardinality (5 values including empty), safe to index.
	stage.labels {
		values = {
			level = "",
		}
	}

	// Final log line is the message with the epoch and any severity prefix
	// stripped. If neither regex matched (msg/body never set), `body`
	// resolves empty and stage.output leaves the original line alone, so
	// nothing is ever dropped.
	stage.output {
		source = "body"
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
