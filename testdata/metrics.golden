# HELP broker_bytes_received $SYS/broker/bytes/received
# TYPE broker_bytes_received counter
broker_bytes_received 1024
# HELP broker_clients_connected $SYS/broker/clients/connected
# TYPE broker_clients_connected gauge
broker_clients_connected 2
# HELP broker_clients_total $SYS/broker/clients/total
# TYPE broker_clients_total counter
broker_clients_total 3
# HELP broker_load_connections_1min $SYS/broker/load/connections/1min
# TYPE broker_load_connections_1min gauge
broker_load_connections_1min 0.25
# HELP broker_messages_sent $SYS/broker/messages/sent
# TYPE broker_messages_sent counter
broker_messages_sent 50
# HELP broker_retained_messages_count $SYS/broker/retained messages/count
# TYPE broker_retained_messages_count gauge
broker_retained_messages_count 7
# HELP broker_shared_subscriptions_count $SYS/broker/shared_subscriptions/count
# TYPE broker_shared_subscriptions_count gauge
broker_shared_subscriptions_count 0
# HELP broker_uptime $SYS/broker/uptime
# TYPE broker_uptime counter
broker_uptime 12345
# HELP mosquitto_exporter_invalid_payloads_total Total number of $SYS payloads that could not be parsed as a number and were therefore not recorded.
# TYPE mosquitto_exporter_invalid_payloads_total counter
mosquitto_exporter_invalid_payloads_total 0
# HELP mosquitto_up Whether the exporter is currently connected to the Mosquitto broker (1) or not (0).
# TYPE mosquitto_up gauge
mosquitto_up 1
